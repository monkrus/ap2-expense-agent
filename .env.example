# AP2 Expense Management Agent - Environment Configuration
# Copy to .env and fill in your values.
# For backend, place in backend/.env. For docker-compose, place in project root.

# ─── Environment ──────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # false in production
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────
# SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ap2_expenses

# ─── JWT / Auth ───────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# ─── Stripe Billing ──────────────────────────────────────
STRIPE_SECRET_KEY=              # sk_test_... from Stripe Dashboard
STRIPE_PUBLISHABLE_KEY=         # pk_test_... from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=          # whsec_... from Stripe Dashboard
# Price IDs from your Stripe Dashboard (Products > Pricing)
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
ENABLE_BILLING=false             # true to enforce tier limits

# ─── QuickBooks Online (Intuit) ───────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/v1/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox   # sandbox | production
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=  # From Intuit Developer Portal > Webhooks

# ─── Email (SMTP) ────────────────────────────────────────
SMTP_SERVER=                     # e.g., smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=                   # e.g., apikey (for SendGrid)
SMTP_PASSWORD=                   # SMTP password or SendGrid API key
SMTP_FROM_EMAIL=noreply@your-domain.com
NOTIFICATIONS_ENABLED=false      # true to send real emails

# ─── Google Cloud (for KMS signing & Cloud Run deploy) ───
GCP_PROJECT_ID=                  # Only needed for AP2 mandate signing & deployment
# GOOGLE_API_KEY=               # Optional: Vertex AI
# GOOGLE_CLOUD_PROJECT=         # Optional: Vertex AI

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ─── Security ─────────────────────────────────────────────
ALLOW_DEV_KMS_FALLBACK=true      # Auto-disabled in production/staging
RATE_LIMIT_ENABLED=true

# ─── Redis (optional) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Subscription Fees ────────────────────────────────────
AP2_TRANSACTION_FEE=0.10
AI_CATEGORIZATION_FEE=0.05
OCR_SCAN_FEE=0.02
TRIAL_PERIOD_DAYS=14

# ─── Legal URLs (required for Intuit App Store) ────────────
PRIVACY_POLICY_URL=https://your-domain.com/privacy
TERMS_OF_SERVICE_URL=https://your-domain.com/terms
