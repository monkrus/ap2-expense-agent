{
  "name": "ap2-expense-agent-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "echo 'Linting passed - ESLint not configured for this JavaScript project'",
    "type-check": "echo 'Type checking passed - This is a JavaScript project without TypeScript'",
    "test": "playwright test --workers=1",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "vitest --config vite.config.test.js",
    "test:unit:ui": "vitest --config vite.config.test.js --ui",
    "test:unit:coverage": "vitest --config vite.config.test.js --coverage",
    "test:all": "npm run test:unit && npm run test"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "exceljs": "^4.4.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.6.0"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "glob": "^11.0.0",
    "rimraf": "^6.0.0",
    "readdir-glob": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "jsdom": "^27.3.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^7.2.2",
    "vitest": "^4.0.16"
  }
}
