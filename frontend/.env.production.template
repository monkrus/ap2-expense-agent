# AP2 Expense Agent Frontend - Production Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Update VITE_API_URL with your backend URL
# 3. This file is included in the build, so only include non-sensitive config
# 4. Do NOT put secrets here - they will be exposed in the browser!

# ============================================================================
# API Configuration (REQUIRED)
# ============================================================================

# Backend API URL (your Cloud Run backend service URL)
VITE_API_URL=<REQUIRED>
# Example: https://ap2-expense-backend-xxxxx.a.run.app/api/v1
# Or with custom domain: https://api.yourdomain.com/api/v1

# ============================================================================
# Stripe Configuration (REQUIRED if using billing)
# ============================================================================

# Stripe Publishable Key (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=<REQUIRED>
# Example: pk_live_...
# This is your PUBLIC key, safe to include in frontend builds

# ============================================================================
# Application Configuration
# ============================================================================

# Application Name
VITE_APP_NAME=AP2 Expense Agent

# Environment
VITE_ENVIRONMENT=production

# ============================================================================
# Feature Flags
# ============================================================================

# Enable features based on your subscription tier
VITE_ENABLE_SUBSCRIPTIONS=true
VITE_ENABLE_STRIPE_BILLING=true
VITE_ENABLE_GCP_MARKETPLACE=true
VITE_ENABLE_EXPENSE_EXPORT=true
VITE_ENABLE_PDF_GENERATION=true
VITE_ENABLE_RECEIPT_UPLOAD=true

# ============================================================================
# UI Configuration
# ============================================================================

# Items per page in lists
VITE_ITEMS_PER_PAGE=20

# Max file upload size (in MB)
VITE_MAX_UPLOAD_SIZE_MB=10

# Supported file types for receipts
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================================================
# Analytics & Monitoring (Optional)
# ============================================================================

# Google Analytics (if using)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (frontend error tracking)
# VITE_SENTRY_DSN=https://...@sentry.io/...
# VITE_SENTRY_ENVIRONMENT=production

# ============================================================================
# External Services
# ============================================================================

# Customer Support (if using Intercom, Zendesk, etc.)
# VITE_INTERCOM_APP_ID=

# Documentation URL
VITE_DOCS_URL=https://docs.yourdomain.com

# Support Email
VITE_SUPPORT_EMAIL=support@yourdomain.com

# ============================================================================
# Build Configuration
# ============================================================================

# Build timestamp (auto-populated by CI/CD)
# VITE_BUILD_TIME=
# VITE_COMMIT_SHA=
# VITE_VERSION=

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# 1. All environment variables must be prefixed with VITE_ to be available
#    in the frontend build (Vite requirement)
#
# 2. These values are embedded in the JavaScript bundle during build time
#    Do NOT include any secrets!
#
# 3. The backend URL should point to your production Cloud Run service
#    or custom domain with /api/v1 path
#
# 4. To update after deployment, you must rebuild and redeploy the frontend
#
# 5. Example build command:
#    npm run build
#    # Output will be in dist/ directory
#
# ============================================================================
