# Production Environment Variables for Backend
# Update these values before deploying

# Database (you'll need to set up Cloud SQL or use external database)
DATABASE_URL=postgresql://user:password@/expenses?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Redis (you'll need to set up Cloud Memorystore or use external Redis)
REDIS_URL=redis://your-redis-host:6379/0

# Application Settings
ENVIRONMENT=production
SECRET_KEY=your-secret-key-change-this-to-a-secure-random-string
ALLOWED_HOSTS=itestapp.com,api.itestapp.com

# Google API
GOOGLE_API_KEY=your-google-api-key

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=https://itestapp.com

# Email Settings (if using email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-app-password
FROM_EMAIL=noreply@itestapp.com

# Google OAuth (if using Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://itestapp.com/auth/google/callback
