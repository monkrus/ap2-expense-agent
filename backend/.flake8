[flake8]
max-line-length = 120
extend-ignore =
    # F401: imported but unused - often used for re-exports and type checking
    F401,
    # F541: f-string missing placeholders - sometimes used for future-proofing
    F541,
    # F811: redefinition - often intentional for overloads
    F811,
    # F841: local variable assigned but never used - often for unpacking
    F841,
    # E501: line too long - black handles this
    E501,
    # E712: comparison to True/False - sometimes more explicit is clearer
    E712,
    # E711: comparison to None - sometimes explicit is clearer
    E711,
    # E722: bare except - used in specific error handling scenarios
    E722,
    # E402: module level import not at top - sometimes needed for conditional imports
    E402,
    # W293: blank line contains whitespace - black handles this
    W293,
    # W503: line break before binary operator - conflicts with black
    W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    migrations,
    alembic
per-file-ignores =
    __init__.py:F401
