# AP2 Expense Management Agent - Production Environment Configuration
#
# INSTRUCTIONS:
# 1. Copy this file to .env.production
# 2. Fill in all required values (marked with <REQUIRED>)
# 3. Generate secure secrets for all secret keys
# 4. NEVER commit .env.production to version control
# 5. Use Google Cloud Secret Manager in production

# ============================================================================
# Database Configuration (REQUIRED)
# ============================================================================

# PostgreSQL Cloud SQL (Production)
# Format: postgresql://username:password@/database?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
DATABASE_URL=<REQUIRED>
# Example: postgresql://ap2user:SECURE_PASSWORD@/expenses?host=/cloudsql/my-project:us-central1:ap2-db

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Security & Authentication (REQUIRED)
# ============================================================================

# JWT Secret - MUST be cryptographically secure!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=<REQUIRED>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Password Reset & Sessions
PASSWORD_RESET_EXPIRATION_HOURS=1
SESSION_EXPIRATION_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# Environment
# ============================================================================

ENVIRONMENT=production
DEBUG=False

# CORS - Production frontend URL(s)
CORS_ORIGINS=https://app.itestapp.com,https://itestapp.com

# Frontend URL (for emails and redirects)
FRONTEND_URL=https://app.itestapp.com

# ============================================================================
# Google Cloud Platform (REQUIRED for AI features)
# ============================================================================

# GCP Project
GOOGLE_CLOUD_PROJECT=<REQUIRED>
# Example: my-gcp-project-123456

GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Service Account (stored in Secret Manager)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-service-account.json

# ============================================================================
# Email Configuration (REQUIRED for production)
# ============================================================================

# SMTP Settings (use SendGrid, Mailgun, or Gmail with App Password)
SMTP_SERVER=<REQUIRED>
# Example: smtp.sendgrid.net

SMTP_PORT=587
SMTP_USERNAME=<REQUIRED>
SMTP_PASSWORD=<REQUIRED>
# Store in Secret Manager: gcloud secrets create smtp-password --data-file=-

SMTP_FROM_EMAIL=support@itestapp.com

# ============================================================================
# Stripe Payment Configuration (REQUIRED)
# ============================================================================

ENABLE_BILLING=True

# Stripe Keys (use LIVE keys for production!)
STRIPE_SECRET_KEY=<REQUIRED>
# Store in Secret Manager: gcloud secrets create stripe-secret-key --data-file=-
# Format: sk_live_...

STRIPE_PUBLISHABLE_KEY=<REQUIRED>
# Format: pk_live_...

STRIPE_WEBHOOK_SECRET=<REQUIRED>
# Store in Secret Manager: gcloud secrets create stripe-webhook-secret --data-file=-
# Get from Stripe Dashboard after creating webhook endpoint
# Format: whsec_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_ID_STARTER=<REQUIRED>
# Format: price_...

STRIPE_PRICE_ID_PROFESSIONAL=<REQUIRED>
STRIPE_PRICE_ID_ENTERPRISE=<REQUIRED>

# ============================================================================
# Google Cloud Marketplace Configuration (REQUIRED for Marketplace)
# ============================================================================

# GCP Project ID (same as above)
GCP_PROJECT_ID=<REQUIRED>
GCP_PROVIDER_ID=<OPTIONAL_DEFAULT_PROJECT_ID>

# Service Account JSON Path (stored in Secret Manager)
GCP_SERVICE_ACCOUNT_PATH=/secrets/gcp-marketplace-sa.json

# Webhook Secret for signature verification
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GCP_WEBHOOK_SECRET=<REQUIRED>
# Store in Secret Manager: gcloud secrets create gcp-webhook-secret --data-file=-

# Enable GCP Marketplace integration
ENABLE_GCP_MARKETPLACE=True
GCP_USAGE_REPORTING_ENABLED=True
GCP_TRIAL_PERIOD_DAYS=14
GCP_GRACE_PERIOD_DAYS=7
GCP_METERING_RETRY_MAX_ATTEMPTS=5
GCP_METERING_RETRY_BACKOFF_SECONDS=60

# ============================================================================
# Subscription & Monetization
# ============================================================================

TRIAL_PERIOD_DAYS=14

# Overage Fees (per unit in USD)
AP2_TRANSACTION_FEE=0.10
AI_CATEGORIZATION_FEE=0.05
OCR_SCAN_FEE=0.02
EXPENSE_OVERAGE_FEE=0.01

# ============================================================================
# Data Retention (in days)
# ============================================================================

AUDIT_LOG_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=30
REVOKED_TOKEN_RETENTION_DAYS=7

# ============================================================================
# Error Tracking & Monitoring
# ============================================================================

# Sentry (optional but recommended)
SENTRY_DSN=<OPTIONAL>
# Get from: https://sentry.io/settings/projects/
# Format: https://...@sentry.io/...

SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# ============================================================================
# Cloud Storage (REQUIRED for receipts)
# ============================================================================

# GCS Bucket for receipts and exports
GCS_BUCKET_NAME=<REQUIRED>
# Example: ap2-expense-receipts-production

# ============================================================================
# Rate Limiting
# ============================================================================

RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ============================================================================
# Logging
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_ACCESS_LOGS=True

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_2FA=True
ENABLE_EMAIL_VERIFICATION=True
ENABLE_OAUTH_GOOGLE=True
ENABLE_AI_CATEGORIZATION=True
ENABLE_OCR_PROCESSING=True

# ============================================================================
# Security Headers
# ============================================================================

ENABLE_HSTS=True
ENABLE_CSP=True
ENABLE_X_FRAME_OPTIONS=True

# ============================================================================
# Performance
# ============================================================================

# Cloud Run specific
WORKERS=4
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=50
TIMEOUT=300

# ============================================================================
# Deployment Info (Auto-populated by CI/CD)
# ============================================================================

# These are typically set by Cloud Run or CI/CD pipeline
# COMMIT_SHA=<auto>
# BUILD_ID=<auto>
# DEPLOYED_AT=<auto>

# ============================================================================
# SECRET MANAGER INTEGRATION
# ============================================================================
#
# In Cloud Run, configure secrets as environment variables:
#
# gcloud run services update ap2-expense-backend \
#   --update-secrets=JWT_SECRET=jwt-secret:latest \
#   --update-secrets=DATABASE_URL=database-url:latest \
#   --update-secrets=STRIPE_SECRET_KEY=stripe-secret-key:latest \
#   --update-secrets=STRIPE_WEBHOOK_SECRET=stripe-webhook-secret:latest \
#   --update-secrets=GCP_WEBHOOK_SECRET=gcp-webhook-secret:latest \
#   --update-secrets=SMTP_PASSWORD=smtp-password:latest \
#   --region us-central1
#
# This automatically injects secrets as environment variables at runtime.
#
# ============================================================================
