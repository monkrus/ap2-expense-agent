# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# JWT & Authentication
JWT_SECRET=<generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))">
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Google AI (Optional - for expense AI features)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# Database Connection Pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# Data Retention (days)
AUDIT_LOG_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=30
REVOKED_TOKEN_RETENTION_DAYS=7

# Security
PASSWORD_RESET_EXPIRATION_HOURS=1
SESSION_EXPIRATION_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@ap2expense.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development
DEBUG=true

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# Stripe Payment Configuration
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Get this from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (create products in Stripe Dashboard first)
# Starter Plan - $29/month
STRIPE_PRICE_ID_STARTER=price_starter_monthly_id

# Professional Plan - $99/month
STRIPE_PRICE_ID_PROFESSIONAL=price_professional_monthly_id

# Enterprise Plan - $399/month
STRIPE_PRICE_ID_ENTERPRISE=price_enterprise_monthly_id

# ============================================================================
# Subscription & Billing Settings
# ============================================================================
# Enable/disable billing features (set to true to activate)
ENABLE_BILLING=false

# Free trial period in days
TRIAL_PERIOD_DAYS=14

# Usage-based fees (per transaction over tier limit)
AP2_TRANSACTION_FEE=0.10
AI_CATEGORIZATION_FEE=0.05
OCR_SCAN_FEE=0.02
