# AP2 Expense Management Agent - Development Configuration
# Copy this file to .env and update the values

# ============================================================================
# Database Configuration
# ============================================================================

# SQLite (Development/Testing) - Default
DATABASE_URL=sqlite:///./test.db

# PostgreSQL (Local Development)
# DATABASE_URL=postgresql://ap2user:your_password@localhost:5432/expenses

# Redis (Optional for development)
REDIS_URL=redis://localhost:6379/0

# Connection Pooling (defaults are fine for development)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Secret - CHANGE THIS for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Password Reset & Sessions
PASSWORD_RESET_EXPIRATION_HOURS=1
SESSION_EXPIRATION_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# Environment
# ============================================================================

ENVIRONMENT=development
DEBUG=True

# CORS - Allowed origins for frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# ============================================================================
# Google Cloud & AI (Optional)
# ============================================================================

# Leave empty for development or add your keys
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=False

# ============================================================================
# Email Configuration (Optional for development)
# ============================================================================

# Leave empty to skip email functionality in development
# For Gmail: Use SMTP_SERVER=smtp.gmail.com and create an App Password
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ap2expense.com

# ============================================================================
# Stripe Payment Configuration (Optional)
# ============================================================================

# Use test keys for development
ENABLE_BILLING=False
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PROFESSIONAL=
STRIPE_PRICE_ID_ENTERPRISE=

# ============================================================================
# Subscription & Monetization (Development defaults)
# ============================================================================

TRIAL_PERIOD_DAYS=14
AP2_TRANSACTION_FEE=0.10
AI_CATEGORIZATION_FEE=0.05
OCR_SCAN_FEE=0.02

# ============================================================================
# Google Cloud Marketplace Configuration (Production only)
# ============================================================================

# GCP Project ID (from GCP Console)
GCP_PROJECT_ID=

# Path to service account JSON key file
# Store in secrets/ directory (never commit to git!)
GCP_SERVICE_ACCOUNT_PATH=

# Webhook secret for signature verification
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GCP_WEBHOOK_SECRET=

# Enable GCP Marketplace integration (set to True for production)
ENABLE_GCP_MARKETPLACE=False
GCP_USAGE_REPORTING_ENABLED=False

# Frontend URL (for emails and redirects)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Data Retention (in days)
# ============================================================================

AUDIT_LOG_RETENTION_DAYS=90
SESSION_RETENTION_DAYS=30
REVOKED_TOKEN_RETENTION_DAYS=7

# ============================================================================
# Error Tracking (Optional)
# ============================================================================

# Leave empty for development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
