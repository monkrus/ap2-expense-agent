# AP2 Expense Management Agent - Production Configuration
# For Google Cloud Platform deployment

# ============================================================================
# Database Configuration
# ============================================================================

# Google Cloud SQL (PostgreSQL)
DATABASE_URL=postgresql://ap2user:CHANGE_ME@/expenses?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Or external PostgreSQL
# DATABASE_URL=postgresql://ap2user:password@your-postgres-host:5432/expenses

# Redis (Cloud Memorystore)
REDIS_URL=redis://10.0.0.1:6379/0

# Connection Pooling for Production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=1800

# ============================================================================
# Security & Authentication
# ============================================================================

# Generate a secure random key:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME  # Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

PASSWORD_RESET_EXPIRATION_HOURS=1
SESSION_EXPIRATION_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================================================
# Environment
# ============================================================================

ENVIRONMENT=production
DEBUG=False

# Update with your production domains
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com,https://api.your-domain.com

# ============================================================================
# Google Cloud & AI
# ============================================================================

GOOGLE_API_KEY=  # Your Google API key
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# ============================================================================
# Email Configuration
# ============================================================================

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=  # Your SMTP password or SendGrid API key
SMTP_FROM_EMAIL=noreply@your-domain.com

# ============================================================================
# Stripe Payment Processor (AP2)
# ============================================================================

ENABLE_BILLING=True
STRIPE_SECRET_KEY=  # sk_live_... from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=  # whsec_... from Stripe Dashboard

# ============================================================================
# Subscription & Monetization
# ============================================================================

TRIAL_PERIOD_DAYS=14
AP2_TRANSACTION_FEE=0.10
AI_CATEGORIZATION_FEE=0.05
OCR_SCAN_FEE=0.02

# ============================================================================
# Data Retention (in days)
# ============================================================================

AUDIT_LOG_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=90
REVOKED_TOKEN_RETENTION_DAYS=30

# ============================================================================
# Error Tracking
# ============================================================================

SENTRY_DSN=  # https://...@sentry.io/...
SENTRY_TRACES_SAMPLE_RATE=0.1
